# Local runtime paths. Keep real galleries outside the public repository.
SELECTIQ_DATA_ROOT=./var
SELECTIQ_FIXTURE_ROOT=./private-fixtures
SELECTIQ_DATABASE_URL=sqlite:///var/selectiq.sqlite3

# Alpha processing defaults
SELECTIQ_MAX_GALLERY_SIZE=30
SELECTIQ_MAX_FILE_SIZE_BYTES=26214400
SELECTIQ_MAX_DECODED_PIXELS=60000000
SELECTIQ_COMPARISON_BUDGET=5
SELECTIQ_MODEL_ADAPTER=openclip
SELECTIQ_EMBEDDING_MODEL=ViT-B-32
SELECTIQ_EMBEDDING_CHECKPOINT=laion2b_s34b_b79k
SELECTIQ_EMBEDDING_BATCH_SIZE=8
SELECTIQ_EMBEDDING_DEVICE=auto
SELECTIQ_FEATURE_VERSION=1
SELECTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# A-04 generative brief interpretation (Groq free tier). Put the real key only in .env.
SELECTIQ_REASONER=groq
GROQ_API_KEY=
SELECTIQ_GROQ_MODEL=qwen/qwen3.8-27b
SELECTIQ_REASONER_TIMEOUT_SECONDS=45
SELECTIQ_REASONER_MAX_REQUESTS_PER_PROJECT=20
